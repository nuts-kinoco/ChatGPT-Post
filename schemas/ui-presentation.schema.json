{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bridge-v2/ui-presentation.schema.json",
  "title": "Bridge presentation preferences, never execution authority",
  "$defs": {
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "alwaysOnTop", "hideWhenInactive", "minimizeToTray", "completionNotifications"],
      "properties": {
        "theme": {"enum": ["light", "dark"]},
        "alwaysOnTop": {"type": "boolean"},
        "hideWhenInactive": {"type": "boolean"},
        "minimizeToTray": {"type": "boolean"},
        "completionNotifications": {"type": "boolean"}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "theme": {"enum": ["light", "dark"]},
        "alwaysOnTop": {"type": "boolean"},
        "hideWhenInactive": {"type": "boolean"},
        "minimizeToTray": {"type": "boolean"},
        "completionNotifications": {"type": "boolean"}
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedRevision", "patch"],
      "properties": {
        "expectedRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
        "patch": {"$ref": "#/$defs/patch"}
      }
    }
  }
}
