{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bridge-v2/ui-request.schema.json",
  "title": "Bridge v2 local UI request bodies",
  "$defs": {
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawSpec",
        "taskMarkdown"
      ],
      "properties": {
        "rawSpec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "taskMarkdown": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskSpecHash",
        "taskFileHash",
        "sequence"
      ],
      "properties": {
        "taskSpecHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "taskFileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "payloadSha256",
        "sequence"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "taskMarkdown": {
          "type": "string",
          "maxLength": 1048000
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ]
        }
      }
    },
    "archive-settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedRevision"
      ],
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "defaultOutputRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "displayName",
            "outputRoot"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[a-f0-9-]{36}$"
            },
            "repo": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "outputRoot": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      }
    },
    "archive-probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
