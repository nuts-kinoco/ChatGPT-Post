{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-web-bridge.local/schemas/result.schema.json",
  "title": "ChatGPT Web Bridge result",
  "description": "Terminal outcome of one request. See docs/12-IO-CONTRACT.md and docs/13-ERROR-MODEL.md.",
  "$defs": {
    "preset": {
      "type": "string",
      "enum": [
        "current",
        "instant",
        "medium",
        "high",
        "extra_high",
        "pro"
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "INVALID_CONFIG",
        "ALREADY_PROCESSED",
        "ALREADY_RUNNING",
        "SUBMIT_STATE_UNKNOWN",
        "PROFILE_IN_USE",
        "BROWSER_LAUNCH_FAILED",
        "INVALID_STATE",
        "AUTH_REQUIRED",
        "CAPTCHA_OR_CHALLENGE",
        "MANUAL_INTERVENTION_REQUIRED",
        "RATE_LIMITED",
        "MODEL_NOT_AVAILABLE",
        "MODEL_NOT_VERIFIABLE",
        "PROMPT_INPUT_FAILED",
        "PROMPT_SUBMIT_FAILED",
        "GENERATION_TIMEOUT",
        "GENERATION_TIMEOUT_ACTIVE",
        "CONVERSATION_MISMATCH",
        "CHAT_ERROR",
        "DOM_CHANGED",
        "EXTRACTION_FAILED",
        "BROWSER_CRASHED",
        "WRITE_FAILED",
        "INTERNAL_ERROR"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "phase",
        "cause"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/stateName"
        },
        "cause": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "stateName": {
      "type": "string",
      "enum": [
        "IDLE",
        "REQUEST_RECEIVED",
        "PRIOR_RESULT_CHECKED",
        "VALIDATED",
        "LOCK_ACQUIRED",
        "MARKER_CHECKED",
        "PROFILE_CHECKED",
        "BROWSER_STARTED",
        "AUTH_CHECKED",
        "NEW_CHAT_READY",
        "PRESET_VERIFIED",
        "PROMPT_ENTERED",
        "PROMPT_SUBMITTING",
        "WAITING_FOR_RESPONSE",
        "GENERATING",
        "STABILIZING",
        "EXTRACTING",
        "WRITING_RESULT"
      ]
    },
    "observedPreset": {
      "type": "string",
      "enum": [
        "instant",
        "medium",
        "high",
        "extra_high",
        "pro"
      ]
    },
    "requestedModel": {
      "type": "string",
      "enum": [
        "current",
        "latest",
        "gpt-5.6-sol",
        "gpt-5.5"
      ]
    },
    "observedModel": {
      "type": "string",
      "enum": [
        "latest",
        "gpt-5.6-sol",
        "gpt-5.5"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bridgeVersion",
    "requestId",
    "status",
    "requestedPreset",
    "observedPreset",
    "requestedModel",
    "observedModel",
    "observedModelSlug",
    "submitted",
    "conversationUrl",
    "responseFile",
    "extractionMethod",
    "extractionQuality",
    "startedAt",
    "completedAt",
    "durationMs",
    "artifacts",
    "images",
    "warnings",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.2"
    },
    "bridgeVersion": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{6,62}[A-Za-z0-9]$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "manual_intervention_required"
      ]
    },
    "requestedPreset": {
      "oneOf": [
        {
          "$ref": "#/$defs/preset"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedPreset": {
      "oneOf": [
        {
          "$ref": "#/$defs/observedPreset"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestedModel": {
      "oneOf": [
        {
          "$ref": "#/$defs/requestedModel"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedModel": {
      "oneOf": [
        {
          "$ref": "#/$defs/observedModel"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedModelSlug": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "submitted": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "conversationUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://chatgpt\\.com/"
    },
    "responseFile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "extractionMethod": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "copy",
        "dom",
        "innerText",
        null
      ]
    },
    "extractionQuality": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "full",
        "degraded",
        null
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^images/[1-9][0-9]*\\.(png|jpg|jpeg|webp|gif)$"
      },
      "description": "1.2 (A-091): generated images saved under <requestDir>/images/, as paths relative to requestDir. [] when none.",
      "uniqueItems": true
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "responseFile": {
            "type": "string"
          },
          "extractionMethod": {
            "type": "string"
          },
          "extractionQuality": {
            "type": "string"
          },
          "observedPreset": {
            "$ref": "#/$defs/observedPreset"
          },
          "submitted": {
            "const": "yes"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          },
          "responseFile": {
            "type": "null"
          },
          "extractionMethod": {
            "type": "null"
          },
          "extractionQuality": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "manual_intervention_required"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "AUTH_REQUIRED",
                  "CAPTCHA_OR_CHALLENGE",
                  "MANUAL_INTERVENTION_REQUIRED",
                  "RATE_LIMITED"
                ]
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "not": {
                  "enum": [
                    "AUTH_REQUIRED",
                    "CAPTCHA_OR_CHALLENGE",
                    "MANUAL_INTERVENTION_REQUIRED",
                    "RATE_LIMITED",
                    "ALREADY_PROCESSED",
                    "ALREADY_RUNNING"
                  ]
                }
              }
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
